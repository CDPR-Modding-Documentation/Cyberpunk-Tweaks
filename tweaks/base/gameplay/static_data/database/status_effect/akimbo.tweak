TripleTequilaPrereq : ORPrereq
{
	nestedPrereqs = 
	[
		{
			conditions += 
			[
				{
					hitFlag = "Headshot";
				} : HitFlagHitPrereqCondition, 
				{
					attackType = "Ranged";
					onlyOncePerShot = true;
				} : AttackTypeHitPrereqCondition, 
				{
					weaponType = "Ranged";
				} : WeaponTypeHitPrereqCondition, 
				{
					npcType = "Any";
					invert = true;
				} : TargetNPCTypeHitPrereqCondition
			];
		} : IsHitTargetAlive, 
		{
			conditions += 
			[
				{
					hitFlag = "WeakspotHit";
				} : HitFlagHitPrereqCondition, 
				{
					attackType = "Ranged";
					onlyOncePerShot = true;
				} : AttackTypeHitPrereqCondition, 
				{
					weaponType = "Ranged";
				} : WeaponTypeHitPrereqCondition, 
				{
					npcType = "Any";
					invert = true;
				} : TargetNPCTypeHitPrereqCondition
			];
		} : IsHitTargetAlive
	];
}

