							} : StatusEffectPrereq, 
							"Perks.IsTargetKilled"
						];
					} : ANDPrereq;
					statPoolUpdates = 
					[
						{
							statPoolType = "BaseStatPools.Stamina";
							statPoolValue = 50f;
						} : StatPoolUpdate
					];
					bool usePercent = true;
