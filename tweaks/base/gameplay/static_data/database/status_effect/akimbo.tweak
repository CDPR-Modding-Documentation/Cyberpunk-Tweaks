package BaseStatusEffect
using RTDB, Prereqs, Effectors, NewPerks, Perks

DoubleTroubleLogic : StatusEffect
{
	bool isAffectedByTimeDilationPlayer = true;
	gameplayTags += 
	[
		"DoubleTroubleLogic"
	];
	duration = "BaseStats.InfiniteDuration";
	fk< GameplayLogicPackage >[] packages = 
	[
		{
			effectors = 
			[
				{
					prereqRecord = "Prereqs.CoolDualWieldGunsHeldPrereq";
					effectorToApply = 
					{
						prereqRecord = 
						{
							conditions += 
							[
								{
									attackType = "QuickMelee";
									invert = true;
								} : AttackTypeHitPrereqCondition
							];
						} : Prereqs.ProcessHitTriggered;
						value = 0.625f;
					} : MultiplyDamage;
				} : ApplyEffectorOnPlayer, 
				{
					prereqRecord = "Perks.PlayerIsAiming";
					statGroup = 
					{
						statModifiers = 
						[
							{
								statType = "BaseStats.RecoilKickMin";
								modifierType = "Multiplier";
								value = 0.85f;
							} : ConstantStatModifier, 
							{
								statType = "BaseStats.RecoilKickMax";
								modifierType = "Multiplier";
								value = 0.85f;
							} : ConstantStatModifier, 
							{
								statType = "BaseStats.SpreadAdsDefaultX";
								modifierType = "Multiplier";
								value = 0.15f;
							} : ConstantStatModifier, 
							{
								statType = "BaseStats.SpreadAdsDefaultY";
								modifierType = "Multiplier";
								value = 0.15f;
							} : ConstantStatModifier, 
							{
								statType = "BaseStats.SpreadAdsFastSpeedMinAdd";
								modifierType = "Multiplier";
								value = 0.f;
							} : ConstantStatModifier, 
							{
								statType = "BaseStats.SpreadAdsFastSpeedMaxAdd";
								modifierType = "Multiplier";
								value = 0.f;
							} : ConstantStatModifier
						];
					};
				} : ApplyStatGroupOnWeapon
			];
		} : GameplayLogicPackage
	];
}

ValentinosFrenzySE : StatusEffect
{
	gameplayTags += 
	[
		"NoQuickMelee"
	];
	fk< GameplayLogicPackage >[] packages = 
	[
		{
			effectors = 
			[
				{
					prereqRecord = 
					{
						conditions += 
						[
							{
								attachmentSlot = "AttachmentSlots.WeaponRight";
							} : WeaponSlotHitPrereqCondition
						];
					} : IsHitTargetAlive;
					int countToRefund = 1;
					CName weapon = "WeaponRight";
					effectorClassName = "ValentinosFrenzyEffector";
				} : Effector, 
				{
					prereqRecord = 
					{
						conditions += 
						[
							{
								attachmentSlot = "AttachmentSlots.WeaponLeft";
							} : WeaponSlotHitPrereqCondition
						];
					} : IsHitTargetAlive;
					int countToRefund = 1;
					CName weapon = "WeaponLeft";
					effectorClassName = "ValentinosFrenzyEffector";
				} : Effector
			];
		}
	];
}

