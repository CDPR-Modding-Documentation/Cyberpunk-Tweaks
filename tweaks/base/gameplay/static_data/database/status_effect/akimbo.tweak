SplashOfLoveLogic : StatusEffect
{
	bool isAffectedByTimeDilationPlayer = true;
	duration = "BaseStats.InfiniteDuration";
	fk< GameplayLogicPackage >[] packages = 
	[
		{
			effectors = 
			[
				{
					effectorToApply = 
					{
						prereqRecord = 
						{
							nestedPrereqs = 
							[
								{
									statusEffect = "BaseStatusEffect.ValentinosFrenzySE";
								} : StatusEffectPrereq, 
								{
									conditions += 
									[
										{
											attackType = "QuickMelee";
											invert = true;
										} : AttackTypeHitPrereqCondition
									];
								} : IsTargetKilled
							];
						} : ANDPrereq;
						effectorClassName = "CeaselessLeadAmmoEffector";
						float percentToRefund = 0.5f;
					} : Effector;
				} : ApplyEffectorOnPlayer
			];
		} : GameplayLogicPackage
	];
}

