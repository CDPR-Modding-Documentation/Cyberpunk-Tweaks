						nestedPrereqs = 
						[
							{
								statusEffect = "BaseStatusEffect.DrinksOnMeBuff";
							} : StatusEffectPrereq, 
							"Perks.IsTargetKilled"
						];
					} : ANDPrereq;
					statType = "BaseStats.TripleTequilaPreviousStackCount";
					statusEffect = "BaseStatusEffect.Triple_Tequila_Stack";
					applicationTarget = "Player";
				} : ApplyStatusEffectBasedOnStatEffector
			];
		} : GameplayLogicPackage
	];
}

