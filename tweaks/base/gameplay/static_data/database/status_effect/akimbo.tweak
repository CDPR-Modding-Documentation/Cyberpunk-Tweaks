SplashOfLoveFireRateSE : StatusEffect
{
	fk< GameplayLogicPackage >[] packages = 
	[
		{
			effectors = 
			[
				{
					prereqRecord = 
					{
						nestedPrereqs = 
						[
							{
								statusEffect = "BaseStatusEffect.ValentinosFrenzySE";
							} : StatusEffectPrereq
						];
					} : ANDPrereq;
					fk< StatModifierGroup > statGroup = 
					{
						statModifiers = 
						[
							{
								statType = "BaseStats.CycleTime";
								modifierType = "Additive";
								value = -0.01f;
							} : ConstantStatModifier, 
							{
								statType = "BaseStats.CycleTime";
								modifierType = "AdditiveMultiplier";
								value = -0.25f;
							} : ConstantStatModifier
						];
					} : StatModifierGroup;
				} : ApplyStatGroupOnWeapon
			];
		}
	];
}

SplashOfLoveDurationSE : StatusEffect
{
	fk< GameplayLogicPackage >[] packages = 
	[
		{
			effectors = 
			[
				{
					prereqRecord = 
					{
						nestedPrereqs = 
						[
							{
								statType = "BaseStatusEffect.Triple_Tequila_Stack";
								valueToCheck = 3;
								comparisonType = "Equal";
							} : StatPrereq, 
							{
								statusEffect = "BaseStatusEffect.Triple_Tequila_Stack";
							} : StatusEffectPrereq
						];
					} : ANDPrereq;
					statusEffect = "BaseStatusEffect.ValentinosFrenzyMaxStacksSE";
				} : ApplyStatusEffectOnPlayer
			];
		}
	];
}

