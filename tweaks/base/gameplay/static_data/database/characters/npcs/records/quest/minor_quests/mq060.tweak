package Character
using RTDB, BaseStats

android_replacer : Player_Replacer_Puppet_Base
{
	priority = "SpawnableObjectPriority.Quest";
	quest = "NPCQuestAffiliation.MinorQuest";
	entityTemplatePath = "base\quest\minor_quests\mq060\entities\mq060_android_replacer_v2.ent";
	savable = true;
	persistentName = "";
	fk< InventoryItemGroup >[] itemGroups = [];
	fk< AttachmentSlot >[] attachmentSlots = 
	[
		"AttachmentSlots.WeaponRight", "AttachmentSlots.WeaponLeft", "AttachmentSlots.RightArm", "AttachmentSlots.PersonalLink", "AttachmentSlots.Consumable"
	];
	fk< StatPool >[] statPools = 
	[
		"BaseStatPools.Player_Health_Base", "BaseStatPools.Player_Stamina_Base", "BaseStatPools.Player_Oxygen_Base", "BaseStatPools.Player_Adrenaline_Base", "BaseStatPools.TutorialMemory", "BaseStatPools.Player_Healing_Charges_Base", "BaseStatPools.Player_Grenades_Charges_Base"
	];
	statModifiers += 
	[
		{
			statType = "BaseStats.MemoryRegenEnabled";
			modifierType = "Multiplier";
			value = 0f;
		} : ConstantStatModifier, 
		{
			statType = "BaseStats.HealthInCombatRegenEnabled";
			modifierType = "Multiplier";
			value = 0f;
		} : ConstantStatModifier, 
		{
			statType = "BaseStats.HealthOutOfCombatRegenEnabled";
			modifierType = "Multiplier";
			value = 0f;
		} : ConstantStatModifier, 
		{
			statType = "BaseStats.Visibility";
			modifierType = "Multiplier";
			value = 0.5f;
		} : ConstantStatModifier
	];
}

